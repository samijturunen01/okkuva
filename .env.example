# Copy this file to `.env` (for local development) and fill in the values.
# Every variable prefixed with VITE_ is PUBLIC – it is embedded in the built
# JavaScript. Never put secrets here. The reCAPTCHA *secret* key lives only in
# the Google Apps Script project (see apps-script/README.md).

# Public URL of the deployed site, without a trailing slash. Used for the
# canonical <link>, Open Graph tags, sitemap.xml and robots.txt.
# This is the ORIGIN only - do NOT append the repo sub-folder. BASE_PATH adds
# that part, so a repo path here ends up duplicated (/okkuva/okkuva/).
# Examples: https://okkuva.fi   or   https://username.github.io
VITE_SITE_URL=

# Google Apps Script Web App URL (Deploy → New deployment → Web app → copy URL).
# Looks like: https://script.google.com/macros/s/AKfycb.../exec
VITE_APPS_SCRIPT_URL=

# Google reCAPTCHA v3 SITE key (the public one).
# Create keys at https://www.google.com/recaptcha/admin  (type: reCAPTCHA v3)
VITE_RECAPTCHA_SITE_KEY=

# Build-time only: public path when hosting under a sub-folder on GitHub Pages.
# Leave empty (or "/") for a custom domain / <user>.github.io repository.
# Example for https://username.github.io/okkuva/  →  BASE_PATH=/okkuva/
BASE_PATH=
